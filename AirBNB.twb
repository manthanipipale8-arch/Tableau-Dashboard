      <aliases enabled='yes' />
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_1755968997113856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number of Records]* [Review Scores Rating]' />
      </column>
      <column caption='Price Category' datatype='string' name='[Calculation_1755968998715393]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt;=300 THEN &quot;Luxury&quot; &#13;&#10;ELSEIF [Price]&gt;=150 THEN &quot;Standard&quot;&#13;&#10;ELSE &quot;Budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Review Category' datatype='string' name='[Calculation_1755969000108034]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews] &gt;=100 THEN &quot;Highly Reviewed&quot;&#13;&#10;ELSE &quot;less reviewed&quot;&#13;&#10;END' />
      </column>
      <column caption='Host status' datatype='string' name='[Calculation_1755969001058308]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since]&lt;= TODAY()THEN &quot;Active Status&quot;&#13;&#10;ELSE &quot;New Host&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_1755969004507145]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt; [Parameters].[Parameter 1755969002590214] THEN &quot;Above Limit&quot;&#13;&#10;ELSE &quot;Below limit&quot; &#13;&#10;END' />
      </column>
